# Copy to .env (never commit .env). Placeholders only.
# Local runs (Ollama + Qwen2.5-3B, our primary backbone) need no key.

# Only for runs with an OpenAI-compatible endpoint (for example configs/amem_gpt-4o-mini.json):
OPENAI_API_KEY=your-key-here

# Set before starting `ollama serve`; the default 4096 cuts prompts off.
OLLAMA_CONTEXT_LENGTH=16384