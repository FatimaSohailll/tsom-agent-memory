# Copy to .env (never commit .env). Placeholders only.
# Local runs (Ollama + Qwen2.5-3B, our primary backbone) need no key.

# Only for runs with an OpenAI-compatible endpoint (stronger-model subset, or the Gemini fallback):
OPENAI_API_KEY=your-key-here
# Only for the Gemini fallback through its OpenAI-compatible endpoint (set as base_url in the config):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
